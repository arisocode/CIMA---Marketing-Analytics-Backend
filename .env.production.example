PORT=3003
DATABASE_HOST=postgres_db
DATABASE_PORT=5432
DATABASE_NAME=crm_database
DB_SCHEMA=schema_marketing
DATABASE_USER=marketing_user
DATABASE_PASSWORD=change-me
CRM_BASE_URL=http://api-gateway:8080
REDIS_URL=redis://redis:6379
COLLAB_PROJECTION_ENABLED=true
COLLAB_EVENTS_STREAM=stream:collab.events

# --- Correos reales por crm-media (Brevo) ---
# true activa el envio real. Con false los correos se registran como SIMULATED.
CIMAXIS_MAIL_ENABLED=false
# Maximo de correos encolados por dia (zona America/Bogota). Brevo gratis da 100
# al dia COMPARTIDOS con crm-auth (invitaciones, restablecer clave): deje margen.
CIMAXIS_MAIL_DAILY_LIMIT=60
# Remitente informativo. El remitente real lo define MAIL_FROM en crm-media.
CIMAXIS_MAIL_FROM=
# Plantilla de correo (opcionales): logo por URL https publica y datos del pie.
CIMAXIS_MAIL_LOGO_URL=
CIMAXIS_MAIL_CONTACT_EMAIL=
CIMAXIS_MAIL_CONTACT_PHONE=
CIMAXIS_MAIL_WEBSITE=
# URL interna de crm-media (por defecto http://crm-media:3002).
# MEDIA_SERVICE_URL=

# --- Llave de firma del JWT de servicio (correo a crm-media) ---
# crm-media verifica la firma con GET /api/v1/.well-known/jwks.json de marketing.
# Sin llave fija, marketing genera una llave efimera NUEVA en cada arranque con
# el mismo kid; crm-media guarda la llave anterior en cache (unos 5 minutos) y
# puede rechazar la firma ("Firma invalida") despues de cada despliegue.
# Genere el par una vez (no lo suba al repositorio):
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out marketing-jwt.pem
#   openssl pkey -in marketing-jwt.pem -pubout -out marketing-jwt.pub.pem
# Pegue el PEM PKCS#8 (BEGIN PRIVATE KEY) en una sola linea: sin saltos de linea
# (tr -d '\n' < marketing-jwt.pem) o con \n literales; ambos formatos sirven.
SERVICE_JWT_KID=
SERVICE_JWT_PRIVATE_KEY=
# Opcional: si se omite, se deriva de la llave privada.
SERVICE_JWT_PUBLIC_KEY=
